# JavaScript dependencies and package-manager caches
**/node_modules/
**/.npm/
**/.pnp
**/.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build and test output
/frontend/build/
/frontend/coverage/
coverage/

# Python environments, bytecode, test, type-check, and lint caches
**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Local training data, learned baselines, and generated model files
/backend/ai-service/data/
*.joblib
*.pkl
*.pickle

# Local environment variables and credentials (keep example templates)
.env
.env.*
!.env.example
!.env.*.example

# Local Docker Compose overrides may contain machine-specific settings
/docker-compose.override.yml
/docker-compose.*.override.yml
!/docker-compose.override.example.yml
!/docker-compose.*.override.example.yml

# Editor, operating-system, and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp

# Local logs
*.log
